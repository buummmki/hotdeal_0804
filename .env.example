# Supabase 대시보드 상단 Connect 버튼, 또는
# Settings > API Keys  (https://supabase.com/dashboard/project/_/settings/api-keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx   # Publishable key (구 anon)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx            # Secret key (구 service_role) - 절대 노출 금지

# 크롤러 & 관리자 보호용 (아무 랜덤 문자열)
CRON_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

NEXT_PUBLIC_SITE_URL=http://localhost:3000
